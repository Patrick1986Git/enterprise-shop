# Local Docker Compose defaults. Copy to .env only for local overrides.
POSTGRES_HOST_PORT=5433
POSTGRES_DB=enterprise_shop_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
APP_DB_USER=shop_dev
APP_DB_PASSWORD=shop_dev
APP_HOST_PORT=8080

# Optional local development overrides; never commit real secrets.
JWT_SECRET=dev-only-secret-that-should-not-be-used-in-production-at-least-256-bits
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PUBLIC_KEY=pk_test_placeholder

# Optional comma-separated explicit origins for a production deployment.
# CORS_ALLOWED_ORIGINS=https://shop.example,https://admin.example
