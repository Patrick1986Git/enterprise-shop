# Local Docker Compose defaults. Copy to .env only for local overrides.
POSTGRES_HOST_PORT=5433
POSTGRES_DB=enterprise_shop_dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
APP_DB_USER=shop_dev
APP_DB_PASSWORD=shop_dev
APP_HOST_PORT=8080

# Optional local development overrides; never commit real secrets.
JWT_KEY_ID=dev-current
JWT_SECRET=ZGV2LW9ubHktand0LXNpZ25pbmcta2V5LTMyLWJ5dGVzISE=
# JWT_PREVIOUS_KEY_ID=dev-previous
# JWT_PREVIOUS_SECRET=<RFC-4648-Base64-of-at-least-32-key-bytes>
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_WEBHOOK_SECRET=whsec_placeholder
STRIPE_PUBLIC_KEY=pk_test_placeholder

# Optional SMTP notification delivery. Socket timeout values must be positive
# durations and individually shorter than the notification claim duration.
NOTIFICATION_SMTP_ENABLED=false
NOTIFICATION_SMTP_FROM=no-reply@enterprise-shop.local
NOTIFICATION_SMTP_CONNECTION_TIMEOUT=PT30S
NOTIFICATION_SMTP_READ_TIMEOUT=PT30S
NOTIFICATION_SMTP_WRITE_TIMEOUT=PT30S

# Optional comma-separated explicit origins for a production deployment.
# CORS_ALLOWED_ORIGINS=https://shop.example,https://admin.example
